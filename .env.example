# 이 파일을 .env로 복사한 뒤 값을 바꿔서 사용하세요. (.env는 git에 커밋하지 않습니다)
DB_NAME=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

HTTP_PORT=80
SAMPLE_DATA_ENABLED=true
