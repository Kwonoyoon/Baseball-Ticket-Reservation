# 이 파일을 .env로 복사한 뒤 값을 바꿔서 사용하세요. (.env는 git에 커밋하지 않습니다)
DB_NAME=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# 32바이트 이상의 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# 입장 QR 서명 키(32바이트 이상, JWT_SECRET과 다른 값 권장). 주석 그대로 두면 JWT_SECRET을 쓴다.
# ENTRY_TICKET_SECRET=change-me-to-another-long-random-secret-at-least-32-bytes

# 첫 관리자 계정 (같은 아이디가 없을 때만 서버 시작 시 만든다. 비밀번호 8자 이상)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 로그인 유지 쿠키의 Secure 속성. HTTPS가 아닌 주소(예: http://192.168.x.x)로 접속할 때만 false
AUTH_COOKIE_SECURE=true

HTTP_PORT=80
SAMPLE_DATA_ENABLED=true

# 예매 완료·취소 알림 메일 발송용 Gmail SMTP 계정 (구글 계정 > 보안 > 앱 비밀번호에서 발급)
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-digit-app-password

# 알림 메일의 "예매 내역 보기" 링크가 가리킬 실제 서비스 주소 (배포 도메인으로 바꾸세요)
APP_BASE_URL=https://your-domain.example.com
